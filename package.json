{
  "name": "wattbyte-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "openapi": "pnpm --filter @wattbyte/api openapi",
    "dart-client": "node scripts/generate-dart-client.mjs",
    "dart-client:check": "node scripts/check-generated-client.mjs",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d --wait",
    "db:wait": "node scripts/wait-for-db.mjs",
    "db:migrate": "pnpm --filter @wattbyte/api migrate",
    "device-specs:check": "node scripts/check-device-specs.mjs",
    "device-specs:sync": "node scripts/check-device-specs.mjs --sync",
    "secret-scan": "node scripts/secret-scan.mjs",
    "test:scripts": "node --test scripts/secret-scan.test.mjs scripts/wait-for-db.test.mjs scripts/is-main.test.mjs",
    "ci:local": "node scripts/secret-scan.mjs && node --test scripts/secret-scan.test.mjs scripts/wait-for-db.test.mjs scripts/is-main.test.mjs && pnpm -r lint && pnpm -r typecheck && pnpm -r test && pnpm -r build && node scripts/check-device-specs.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
