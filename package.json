{
  "name": "wattbyte-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "openapi": "pnpm --filter @wattbyte/api openapi",
    "dart-client": "node scripts/generate-dart-client.mjs",
    "dart-client:check": "node scripts/check-generated-client.mjs",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d --wait",
    "openapi:compat": "node scripts/check-openapi-compat.mjs",
    "db:wait": "node scripts/wait-for-db.mjs",
    "test:db": "node scripts/test-db.mjs",
    "openapi:check": "pnpm --filter @wattbyte/api openapi -- --check",
    "db:migrate": "pnpm --filter @wattbyte/api migrate",
    "device-specs:check": "node scripts/check-device-specs.mjs",
    "device-specs:sync": "node scripts/check-device-specs.mjs --sync",
    "secret-scan": "node scripts/secret-scan.mjs",
    "secret-scan:history": "node scripts/secret-scan-history.mjs",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "smoke:image": "node scripts/smoke-image.mjs",
    "workflows:check": "node scripts/check-workflow-pins.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "ci:local": "node scripts/secret-scan.mjs && node scripts/check-workflow-pins.mjs && node scripts/check-docs.mjs && pnpm test:scripts && pnpm -r lint && pnpm -r typecheck && pnpm openapi:check && pnpm -r test && pnpm -r build && node scripts/check-device-specs.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
