{
  "_comment": "Reviewed allowlist for scripts/check-public-config.mjs (PRIVATE_CONFIG_DENY_BY_DEFAULT). A configuration-like file that no entry covers fails the gate. Every entry must say why the file is needed and how it was reviewed; classes are PUBLIC_BUILD_REQUIRED, PUBLIC_EXAMPLE or PUBLIC_SOURCE. Files whose NAME is private (env files, keys, keystores, real wrangler config, ...) can never be allowlisted: scripts/check-public-config.mjs rejects them first.",
  "version": 1,
  "maxFileBytes": 5242880,
  "denyPaths": [
    "docs/remediation",
    "docs/AUDIT.md",
    "docs/STATUS.md",
    "docs/FIX_REPORT.md",
    "docs/IOS_SIMULATOR_REPORT.md",
    "docs/security/PUBLIC_RELEASE_AUDIT.md",
    "docs/security/PUBLIC_RELEASE_REPORT.md",
    "docs/security/WATTBYTE_OS_RELEASE_REPORT.md",
    "docs/security/PUBLIC_SYNC_WORKFLOW.md",
    "infrastructure/public-overlay",
    "scripts/public-export.mjs",
    "scripts/public-export.config.json"
  ],
  "allowContent": [],
  "allow": [
    { "glob": "**/package.json", "class": "PUBLIC_BUILD_REQUIRED", "reason": "npm workspace manifests: scripts, engines, dependencies", "envValues": false, "review": "read; scripts and version ranges only" },
    { "glob": "**/tsconfig*.json", "class": "PUBLIC_BUILD_REQUIRED", "reason": "TypeScript compiler settings", "envValues": false, "review": "content scan clean; compiler options only" },
    { "glob": "pnpm-workspace.yaml", "class": "PUBLIC_BUILD_REQUIRED", "reason": "workspace layout, build-script allowlist and the documented audit exception", "envValues": false, "review": "read; no identifiers" },
    { "glob": "pnpm-lock.yaml", "class": "PUBLIC_BUILD_REQUIRED", "reason": "reproducible installs (CI uses --frozen-lockfile)", "envValues": false, "review": "generated; registry URLs and integrity hashes only" },
    { "glob": ".nvmrc", "class": "PUBLIC_BUILD_REQUIRED", "reason": "Node version for contributors", "envValues": false, "review": "read; one version number" },
    { "glob": "**/.gitignore", "class": "PUBLIC_BUILD_REQUIRED", "reason": "keeps private files out of commits", "envValues": false, "review": "read; patterns only" },
    { "glob": ".gitattributes", "class": "PUBLIC_BUILD_REQUIRED", "reason": "line endings and binary handling", "envValues": false, "review": "read; patterns only" },
    { "glob": ".dockerignore", "class": "PUBLIC_BUILD_REQUIRED", "reason": "keeps env files and secrets out of the Docker build context", "envValues": false, "review": "read; patterns only" },
    { "glob": ".gitleaks.toml", "class": "PUBLIC_BUILD_REQUIRED", "reason": "second secret scanner; allowlists one rule in test directories only", "envValues": false, "review": "read; no values" },
    { "glob": "openapitools.json", "class": "PUBLIC_BUILD_REQUIRED", "reason": "pins the OpenAPI generator version for the Dart client", "envValues": false, "review": "read; version pin" },
    { "glob": ".github/workflows/*.yml", "class": "PUBLIC_BUILD_REQUIRED", "reason": "CI, and the manually started release workflow", "envValues": false, "review": "read; secrets referenced by name only, actions pinned to commit SHAs, read-only token" },
    { "glob": ".github/dependabot.yml", "class": "PUBLIC_BUILD_REQUIRED", "reason": "dependency update policy", "envValues": false, "review": "read; no identifiers" },
    { "glob": ".github/rulesets/main.json", "class": "PUBLIC_BUILD_REQUIRED", "reason": "branch ruleset applied by scripts/github-protect-main.sh", "envValues": false, "review": "read; rule types and check names only" },
    { "glob": ".github/CODEOWNERS", "class": "PUBLIC_BUILD_REQUIRED", "reason": "review ownership", "envValues": false, "review": "read; the maintainer's public GitHub handle" },
    { "glob": ".github/ISSUE_TEMPLATE/*.yml", "class": "PUBLIC_SOURCE", "reason": "issue forms", "envValues": false, "review": "read; text only" },
    { "glob": "packages/contracts/openapi/openapi.json", "class": "PUBLIC_SOURCE", "reason": "the published API contract, generated from the routes", "envValues": false, "review": "generated; example values only" },
    { "glob": "packages/device-specs/src/devices.json", "class": "PUBLIC_SOURCE", "reason": "device catalog (manufacturer-published facts)", "envValues": false, "review": "data; no personal values" },
    { "glob": "apps/mobile/assets/device_specs/devices.json", "class": "PUBLIC_SOURCE", "reason": "copy of the device catalog bundled in the app (drift-checked)", "envValues": false, "review": "data; identical to packages/device-specs" },
    { "glob": "scripts/openapi-generator.pin.json", "class": "PUBLIC_BUILD_REQUIRED", "reason": "pinned generator jar and its SHA-256", "envValues": false, "review": "read; checksum only" },
    { "glob": "scripts/secret-scan.allow.json", "class": "PUBLIC_BUILD_REQUIRED", "reason": "documented synthetic fixtures of the secret scanner", "envValues": false, "review": "read; patterns and reasons" },
    { "glob": "scripts/public-config.allowlist.json", "class": "PUBLIC_BUILD_REQUIRED", "reason": "this allowlist", "envValues": false, "review": "read; names and reasons only" },
    { "glob": "apps/api/Dockerfile", "class": "PUBLIC_BUILD_REQUIRED", "reason": "reference image of the API (non-root, health check)", "envValues": false, "review": "read; no credentials, no private registry" },
    { "glob": "infrastructure/docker/docker-compose.yml", "class": "PUBLIC_EXAMPLE", "reason": "local PostgreSQL for development and tests", "envValues": true, "review": "read; documented throw-away credentials, published on 127.0.0.1 only" },
    { "glob": "apps/api/.env.example", "class": "PUBLIC_EXAMPLE", "reason": "every API environment variable with a placeholder", "envValues": true, "review": "read; synthetic values only" },
    { "glob": "apps/web/.env.example", "class": "PUBLIC_EXAMPLE", "reason": "website environment variables", "envValues": true, "review": "read; empty or public values" },
    { "glob": "apps/web/wrangler.example.jsonc", "class": "PUBLIC_EXAMPLE", "reason": "Cloudflare deployment template; the real wrangler.jsonc is the deployer's own and is git-ignored", "envValues": true, "review": "read; placeholders on reserved example domains" },
    { "glob": "apps/mobile/config/*.example.json", "class": "PUBLIC_EXAMPLE", "reason": "build defines per environment", "envValues": true, "review": "read; hosts under the reserved .invalid TLD that the app refuses on purpose" },
    { "glob": "apps/mobile/**/pubspec.yaml", "class": "PUBLIC_BUILD_REQUIRED", "reason": "Flutter dependencies and assets", "envValues": false, "review": "content scan clean" },
    { "glob": "apps/mobile/analysis_options.yaml", "class": "PUBLIC_BUILD_REQUIRED", "reason": "Dart analyzer rules", "envValues": false, "review": "content scan clean" },
    { "glob": "apps/mobile/dart_test.yaml", "class": "PUBLIC_BUILD_REQUIRED", "reason": "Dart test configuration", "envValues": false, "review": "content scan clean" },
    { "glob": "apps/mobile/l10n.yaml", "class": "PUBLIC_BUILD_REQUIRED", "reason": "localization generator settings", "envValues": false, "review": "content scan clean" },
    { "glob": "apps/mobile/**/*.gradle.kts", "class": "PUBLIC_BUILD_REQUIRED", "reason": "Android and plugin build scripts; release signing is read from git-ignored key.properties or CI environment variables", "envValues": false, "review": "read build.gradle.kts of the app; no signing values" },
    { "glob": "apps/mobile/android/gradle.properties", "class": "PUBLIC_BUILD_REQUIRED", "reason": "Gradle flags", "envValues": false, "review": "read; memory flags and AndroidX switches" },
    { "glob": "apps/mobile/android/gradle/wrapper/gradle-wrapper.properties", "class": "PUBLIC_BUILD_REQUIRED", "reason": "Gradle wrapper version", "envValues": false, "review": "read; official distribution URL" },
    { "glob": "apps/mobile/android/**/*.xml", "class": "PUBLIC_SOURCE", "reason": "Android manifests and resources", "envValues": false, "review": "manifests read; no API keys or hosts" },
    { "glob": "apps/mobile/packages/**/*.xml", "class": "PUBLIC_SOURCE", "reason": "plugin manifest and drawable", "envValues": false, "review": "content scan clean" },
    { "glob": "apps/mobile/ios/**/*.plist", "class": "PUBLIC_SOURCE", "reason": "iOS Info.plist and workspace settings", "envValues": false, "review": "read; no keys, no team id" },
    { "glob": "apps/mobile/ios/**/*.xcconfig", "class": "PUBLIC_BUILD_REQUIRED", "reason": "shared Xcode build settings; the signing team comes from the git-ignored Local.xcconfig", "envValues": false, "review": "read WattByte.xcconfig; no Team ID anywhere" },
    { "glob": "apps/mobile/ios/**/*.entitlements", "class": "PUBLIC_SOURCE", "reason": "App Group entitlement of the app and the widget", "envValues": false, "review": "content scan clean; derived from the bundle id" },
    { "glob": "apps/mobile/ios/Podfile", "class": "PUBLIC_BUILD_REQUIRED", "reason": "CocoaPods setup", "envValues": false, "review": "content scan clean" },
    { "glob": "apps/mobile/ios/Podfile.lock", "class": "PUBLIC_BUILD_REQUIRED", "reason": "pinned pod versions", "envValues": false, "review": "generated; versions and checksums" },
    { "glob": "apps/mobile/ios/**/Contents.json", "class": "PUBLIC_SOURCE", "reason": "Xcode asset catalog descriptors", "envValues": false, "review": "generated by Xcode; file names and sizes" }
  ]
}
