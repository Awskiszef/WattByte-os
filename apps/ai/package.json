{
  "name": "@wattbyte/ai",
  "version": "0.1.0",
  "private": true,
  "description": "WattByte AI Gateway: one interface over OpenAI, Anthropic, Google and xAI with routing, fallback, structured output and usage accounting.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "smoke:ai": "tsc -p tsconfig.smoke.json && node --env-file-if-exists=../api/.env dist-smoke/scripts/smoke.js"
  },
  "dependencies": {
    "openai": "^7.32.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
