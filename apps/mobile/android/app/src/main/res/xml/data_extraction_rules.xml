<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (targetSdk 31+): nothing of this app is backed up to the cloud or copied to a new phone.
     The SQLite database, the shared preferences and the Keystore-wrapped tokens are only meaningful on this
     device. Older Android versions use android:allowBackup="false" in the manifest. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
