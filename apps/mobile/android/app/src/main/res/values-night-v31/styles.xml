<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark variant of values-v31/styles.xml: a resource folder with the night qualifier outranks the API-level
         qualifier, so the splash attributes have to be repeated here. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
