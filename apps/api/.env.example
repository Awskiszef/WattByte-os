# Template for local development. Every variable, its default and the rules per environment:
# docs/CONFIGURATION.md. The server reads the process environment; load this file with
#   node --env-file=.env ...        (or export the variables in your shell / deployment).
# Never commit a real .env: `node scripts/secret-scan.mjs` fails on real secrets.

# ---------------------------------------------------------------- environment
NODE_ENV=development
# development | staging | production. Unset: production when NODE_ENV=production, otherwise development.
# staging and production REFUSE to start with a placeholder or repeated-pattern JWT_SECRET, AI_MOCK=1,
# no DATABASE_URL or the docker-compose credentials; production also needs DATABASE_SSL set explicitly.
# They also require NODE_ENV=production.
APP_ENV=development
PORT=8080
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent. JSON lines on stdout, never secrets or personal data.
LOG_LEVEL=info

# ------------------------------------------------------------------ database
# PostgreSQL (see infrastructure/docker/docker-compose.yml). The credentials below are the throw-away
# local ones; staging and production refuse them.
DATABASE_URL=postgres://wattbyte:wattbyte@localhost:5432/wattbyte
# 1 = TLS with certificate verification. Production: set it explicitly (1, or 0 for a private link).
DATABASE_SSL=0
# With DATABASE_SSL=1 do not put sslmode=... in DATABASE_URL (a weaker one is refused). Private-CA server: a PEM file.
# DATABASE_SSL_CA_FILE=/etc/wattbyte/db-ca.pem
# Pool size and the per-statement limit (defaults shown).
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# How long GET /ready waits for `SELECT 1` before answering 503.
READY_DB_TIMEOUT_MS=2000
# HTTP server limits (defaults shown): whole-request deadline, idle keep-alive (just above the balancer's idle
# timeout), open connections (0 = unlimited), requests per connection (0 = unlimited).
REQUEST_TIMEOUT_MS=30000
# Per-IP (IPv6: per /64) requests per minute on POST /auth/refresh; credential endpoints share AUTH_RATE_LIMIT_PER_MIN.
REFRESH_RATE_LIMIT_PER_MIN=60
# Password hashing (64 MiB scrypt each): hashes at once, hashes allowed to wait, then 503 + Retry-After.
SCRYPT_CONCURRENCY=2
SCRYPT_MAX_QUEUE=8
KEEP_ALIVE_TIMEOUT_MS=65000
MAX_CONNECTIONS=5000
MAX_REQUESTS_PER_SOCKET=1000
# Graceful shutdown: /ready turns 503 on SIGTERM, the process waits SHUTDOWN_DRAIN_MS, then closes; the whole
# sequence is cut off after SHUTDOWN_TIMEOUT_MS (keep it below the orchestrator's grace period).
SHUTDOWN_DRAIN_MS=3000
SHUTDOWN_TIMEOUT_MS=25000

# ---------------------------------------------------------------------- auth
# At least 32 random characters, e.g. `openssl rand -base64 48`. This placeholder only works in development.
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# A rotated refresh token presented again LESS than this many seconds after its rotation is a retry
# (rejected, nothing else revoked); at or after it, it is theft and every session of the user is revoked.
REFRESH_REUSE_GRACE_SEC=60
# A sign-in (session family) ends this many days after it started, however often its refresh token rotates.
SESSION_ABSOLUTE_LIFETIME_DAYS=90

# ------------------------------------------------------------- feature flags
# 0/1. A disabled feature answers 503 `feature_disabled`; the app reads the flags from GET /api/v1/config.
FEATURE_AI=1
# Off until the subscriptions module is live.
FEATURE_SUBSCRIPTIONS=0
FEATURE_CLOUD_SYNC=1

# ------------------------------------------------------------------------ AI
# AI quotas (generations per UTC day). Published to the app in GET /api/v1/config.
AI_FREE_DAILY_LIMIT=3
AI_PREMIUM_DAILY_LIMIT=50
# AI providers: configure any subset. A key REQUIRES at least one model name (no model is hardcoded);
# insight/roast use *_FAST_MODEL, weekly/monthly summaries use *_QUALITY_MODEL (each falls back to the other).
# Unset providers are skipped by the router. Keys exist ONLY on the server: never in the app, never in git.
# Development: put real keys in your own untracked .env (git ignores it). Production: the deployment's secret store.
# 1 = deterministic mock provider, no keys needed. Development only: refused in staging and production.
AI_MOCK=0
OPENAI_API_KEY=
OPENAI_FAST_MODEL=
OPENAI_QUALITY_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=
ANTHROPIC_QUALITY_MODEL=
GOOGLE_AI_API_KEY=
GEMINI_FAST_MODEL=
GEMINI_QUALITY_MODEL=
XAI_API_KEY=
XAI_FAST_MODEL=
XAI_QUALITY_MODEL=

# How a request uses the providers (docs/ai.md). Time values are milliseconds.
# Tried first for every task, when it has a key: openai | anthropic | google | xai.
# Unset = each task keeps its own routing order. A default without a key is a boot error.
AI_DEFAULT_PROVIDER=
# The whole request: every call, retry pause and the fallback together. The app gives up after 90 s.
AI_REQUEST_TIMEOUT_MS=60000
# One call to one provider (at most the request budget).
AI_ATTEMPT_TIMEOUT_MS=20000
# Extra calls to the same provider after a transient failure (429, 5xx, no connection), 0 to 5,
# waiting 500 ms, 1 s, 2 s ... with jitter. A timeout, a bad request, a bad key or a refusal is never retried.
AI_MAX_RETRIES=2
# 1/0. After a failure that allows it (timeout, 429, 5xx, no connection) the request may go to ONE other provider.
AI_FALLBACK_ENABLED=1
# 1/0. Whether a 429 counts as such a failure.
AI_FALLBACK_ON_RATE_LIMIT=1

# Cost tracking and limits, in USD. Costs are estimates unless the provider reports the charge (xAI does) or prices are set here.
# JSON, USD per 1M tokens: {"<model name>":{"input":0.4,"output":1.6}}
AI_MODEL_PRICES=
# Limits over all providers per UTC day / UTC month, and per provider per UTC day ({"openai":5,"xai":2}). Unset = no limit.
AI_BUDGET_DAILY_USD=
AI_BUDGET_MONTHLY_USD=
AI_BUDGET_PROVIDER_DAILY_USD=
# The free plan's share of the day's budget (default: half of AI_BUDGET_DAILY_USD). Free accounts cost nothing to create.
AI_BUDGET_FREE_DAILY_USD=
# Staging/production with real AI providers REFUSE to start without AI_BUDGET_DAILY_USD (and a price for every configured
# model in AI_MODEL_PRICES) unless this is 1: a conscious "no spend ceiling in this application" (logged at every boot).
AI_BUDGET_UNLIMITED=0

# ------------------------------------------------------------ rate limiting
# Requests per minute per client IP, IPv6 per /64 (global / login+register+OAuth together / each AI route).
RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT_PER_MIN=10
AI_RATE_LIMIT_PER_MIN=20
# AI generations running at once in this process; beyond that 503 + Retry-After at once instead of a backlog of paid calls.
AI_MAX_CONCURRENT=16
# Number of reverse proxies in front of the API (0 = trust no X-Forwarded-For). Behind a proxy set it,
# otherwise all clients share the proxy's rate-limit bucket (logged as a warning in staging/production).
TRUST_PROXY_HOPS=0
# Preferred behind a proxy (instead of the hop count): the proxies' own addresses/CIDRs. X-Forwarded-For and
# COUNTRY_HEADER are then believed only on connections from them. Leave unset together with HOPS>0 never; pick one.
# TRUST_PROXY_CIDRS=10.0.0.0/8,fd00::/8

# ----------------------------------------------------------------- retention
# `pnpm --filter @wattbyte/api retention` (run daily) purges ai_generations older than this many days.
# Sessions expired/revoked for 30 days and AI quota counters older than 7 days are purged too.
AI_HISTORY_RETENTION_DAYS=90

# ---------------------------------------------------------------- price data
# Household electricity prices (GET /api/v1/electricity-price): Eurostat nrg_pc_204, cached this long (hours).
ELECTRICITY_PRICE_CACHE_HOURS=168
# EUROSTAT_BASE_URL=https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data
# Header carrying the caller's country when a proxy such as Cloudflare sets one; empty disables /region detection.
COUNTRY_HEADER=
