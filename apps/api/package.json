{
  "name": "@wattbyte/api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "WattByte REST API: auth, devices, aggregate sync, AI gateway access.",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=${NODE_ENV:-development} node --env-file-if-exists=.env --conditions=development --import tsx --watch src/main.ts",
    "start": "UV_THREADPOOL_SIZE=${UV_THREADPOOL_SIZE:-8} node dist/main.js",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=.env --conditions=development --import tsx src/database/migrate.ts",
    "retention": "node --env-file-if-exists=.env --conditions=development --import tsx src/scripts/retention.ts",
    "migrate:prod": "node dist/database/migrate.js",
    "retention:prod": "node dist/scripts/retention.js",
    "openapi": "node --conditions=development --import tsx src/scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.0",
    "@wattbyte/ai": "workspace:*",
    "@wattbyte/contracts": "workspace:*",
    "@wattbyte/device-specs": "workspace:*",
    "fastify": "^5.12.6",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
