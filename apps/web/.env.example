# Public origin of the site, used for canonical URLs, sitemap and Open Graph. Default: https://wattbyte.app
NEXT_PUBLIC_SITE_URL=https://wattbyte.app
# Where /api/launch-list forwards sign-ups (any HTTPS endpoint that accepts JSON { email, platform, source }).
# Unset = the launch list is closed and the form explains that.
LAUNCH_LIST_WEBHOOK_URL=
# Optional bearer token sent with the webhook request.
LAUNCH_LIST_WEBHOOK_TOKEN=
