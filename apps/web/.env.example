# Public origin of the site, used for canonical URLs, sitemap and Open Graph. Default: https://wattbyte.app
NEXT_PUBLIC_SITE_URL=https://wattbyte.app
# Where /api/launch-list forwards sign-ups (any HTTPS endpoint that accepts JSON
# { email, platform, source, at, utm_source?, utm_medium?, utm_campaign?, utm_content? }; the utm_* keys are
# present only when the visitor landed through a tagged link).
# Unset = the launch list is closed and the form explains that.
# Production uses the Google Sheet receiver: `<Apps Script web app URL>?key=<KEY>` (README, "Launch-list receiver").
LAUNCH_LIST_WEBHOOK_URL=
# Optional bearer token sent with the webhook request (unused with the Google Sheet receiver, which cannot read headers).
LAUNCH_LIST_WEBHOOK_TOKEN=
